
{
  "manifest_version": 3,
  "name": "AI Form Assistant",
  "version": "1.0.0",
  "description": "Automatically fill website forms using your saved profile.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Form Assistant"
  }
}
